{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aislop.gr/skinshift/theme-registry.schema.json",
  "title": "SkinShift theme registry",
  "type": "object",
  "required": ["themes"],
  "properties": {
    "themes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "description", "wallpaper", "mark", "accent", "accentSoft", "overlay"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 32 },
          "description": { "type": "string", "minLength": 1, "maxLength": 80 },
          "wallpaper": { "type": "string", "pattern": "^themes/.+/wallpaper\\.webp$" },
          "mark": { "type": "string", "pattern": "^themes/.+/mark\\.svg$" },
          "accent": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
          "accentSoft": { "type": "string" },
          "overlay": { "type": "string" }
        }
      }
    }
  }
}
